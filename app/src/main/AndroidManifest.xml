<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Only for the one-time download of the Vosk wake word model -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Phase 3: calls and contacts -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Phase 4: alarm/timer, Wi-Fi state, opening apps from the background -->
    <uses-permission android:name="android.permission.SET_ALARM" />
    <!-- Phase 9: photos (own camera screen) and optional self-enabling of Accessibility via ADB-granted permission -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Phase 10: brightness (system settings) and silent mode (Do Not Disturb access), both granted by the person in Settings -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Phase 3 (new actions): send/read SMS, reminders that survive a reboot and fire on time -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <!-- Phase 4: pick a Bluetooth device for a routine, and hear it connect -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Android 11+ package visibility: without these, STT and TTS engines are not found -->
    <queries>
        <!-- every app that has a launcher icon: needed to open apps by name -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".BuildXApp"
        android:allowBackup="false"
        android:label="BuildX AI"
        android:theme="@android:style/Theme.DeviceDefault.Light">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Opened by the Quick Settings tile; starts the service from the foreground -->
        <activity
            android:name=".StartListeningActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".WakeService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name=".ListenTile"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="BuildX"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Phase 5: lock the screen, tap the Wi-Fi/Bluetooth toggle. Off until the person enables it in Accessibility settings. -->
        <activity
            android:name=".ChecklistActivity"
            android:exported="false" />

        <activity
            android:name=".photo.PhotoActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen"
            android:turnScreenOn="true" />

        <service
            android:name=".a11y.BuildXAccessibilityService"
            android:exported="false"
            android:label="BuildX AI"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

            <!-- Phase 8: BuildX as the phone's "Default digital assistant app" (popup over the lock screen, system keeps it alive) -->
        <service
            android:name=".assistant.BuildXVoiceInteractionService"
            android:exported="true"
            android:label="BuildX AI"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction_service" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>
        <service
            android:name=".assistant.BuildXSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />
        <!-- Required by the assistant declaration; it only reports "not supported" (the app uses the phone's own recognizer) -->
        <service
            android:name=".assistant.BuildXRecognitionService"
            android:exported="true"
            android:label="BuildX AI">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/recognition_service" />
        </service>

        <!-- The "থামাও" button on the screen-agent notification. Not reachable from other apps. -->
        <receiver
            android:name=".agent.AgentStopReceiver"
            android:exported="false" />

        <!-- Only for "lock the screen" when Accessibility cannot be turned on. Can do nothing else (force-lock only). -->
        <receiver
            android:name=".admin.BuildXDeviceAdmin"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Reminders: the alarm lands here; after a reboot or an update they are set again -->
        <receiver
            android:name=".reminder.ReminderReceiver"
            android:exported="false" />
        <receiver
            android:name=".routine.RoutineAlarmReceiver"
            android:exported="false" />
        <receiver
            android:name=".reminder.ReminderBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Lets "নোটিফিকেশন পড়ো" / "কে কল করছে" see what is on the notification shade. Off until allowed in Notification access. -->
        <service
            android:name=".notif.BuildXNotificationListener"
            android:exported="true"
            android:label="BuildX AI"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>
</manifest>
